# Copia este fichero como .env y rellena tus claves (el .env nunca se sube a GitHub)

# https://the-odds-api.com  → plan Starter gratis (500 créditos/mes)
ODDS_API_KEY=
# https://dashboard.api-football.com  → opcional; el plan gratis no incluye la temporada actual
APIFOOTBALL_KEY=

# Bot de Telegram: créalo con @BotFather y luego ejecuta `python -m radar telegram-test` para ver tu chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Banca y riesgo
BANKROLL=100            # dinero que dedicas a esto (no el que necesitas)
KELLY_FRACTION=0.25     # fracción de Kelly: 0.25 = prudente
MAX_STAKE_PCT=0.03      # nunca más del 3 % de la banca en una apuesta

# Casas donde tienes cuenta (vacío = todas menos Pinnacle, que no opera en España)
# BET_BOOKS=bet365
# BET_BOOKS=bet365,bwin,williamhill,betfair_ex_eu

# Filtros
MIN_EV=0.04             # valor esperado mínimo para guardar una jugada (+4 %)
ALERT_EV=0.06           # valor esperado mínimo para avisar por Telegram (+6 %)
MIN_PROB=0.25           # no marcar selecciones con menos de un 25 % de probabilidad
MAX_ODDS=6.0

# Cuotas: región o hasta 10 casas concretas (mismo coste que 1 región)
ODDS_REGIONS=eu
# Ejemplo (comprueba las claves exactas en https://the-odds-api.com/sports-odds-data/bookmaker-apis.html):
# ODDS_BOOKMAKERS=bet365,williamhill,betfair_ex_eu,unibet_eu,marathonbet
ODDS_MARKETS=h2h,totals
