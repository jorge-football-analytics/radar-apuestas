# Copia este fichero como .env y rellena tus claves (el .env nunca se sube a GitHub)

# https://the-odds-api.com  → plan Starter gratis (500 créditos/mes)
ODDS_API_KEY=
# https://oddspapi.io → plan gratis (250 consultas/mes). Da las cuotas de bet365 de tenis, NBA, NFL y copas europeas
ODDSPAPI_KEY=
# https://dashboard.api-football.com  → opcional; el plan gratis no incluye la temporada actual
APIFOOTBALL_KEY=

# Bot de Telegram: créalo con @BotFather y luego ejecuta `python -m radar telegram-test` para ver tu chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Banca y riesgo
BANKROLL=100            # dinero que dedicas a esto (no el que necesitas)
KELLY_FRACTION=0.25     # fracción de Kelly: 0.25 = prudente
MAX_STAKE_PCT=0.03      # nunca más del 3 % de la banca en una apuesta

# Deportes activos
SPORTS=football,tennis,basketball,nfl

# Filtros (siempre con cuotas de bet365)
MIN_EV=0.025            # Élite: valor esperado mínimo frente al precio justo limpio (+2,5 %)
ALERT_EV=0.03           # Telegram: +3 % y referencia sharp (Pinnacle o exchange)
ALERT_MAX_DAY=5         # máximo de avisos élite al día
MIN_PROB=0.30
MIN_ODDS=1.30           # rango de cuotas recomendable: fuera de él, solo información
MAX_ODDS=2.60
SOLID_MIN_PROB=0.65     # Sólida: probabilidad real mínima
SOLID_MIN_EV=-0.005     # Sólida: bet365 paga al menos el precio justo (−0,5 % de tolerancia)
COMBO_MIN_EV=0.02       # combinada 'con valor'
COMBO_SOLID_MIN_EV=-0.015  # combinada 'sólida'
COMBO_MAX_PER_LEAGUE=1  # descorrelación: patas por liga
MAX_EV=0.15             # más valor que esto = error de datos casi seguro → 'revisar', apuesta 0
MIN_BOOKS=2             # casas válidas (sin contar bet365) necesarias para fiarse del precio justo

# Limpieza de cuotas
MAX_OVERROUND=1.12      # margen máximo creíble de una casa (exchanges: 0,99-1,04)
MAX_ODDS_GAP_H=6        # solo se comparan cuotas tomadas como mucho 6 h antes o después de la de bet365
B365_MAX_AGE_H=24       # cuota de bet365 más vieja → 'verificar' (football-data solo publica martes y viernes)
FROZEN_MODEL_SPORTS=football,tennis   # deportes en los que el modelo propio NO mueve la probabilidad
RECAL_MIN_N=2000        # predicciones resueltas necesarias para mover el peso del backtest
METRICS_SINCE=          # p. ej. 2026-11-27: medir el rendimiento solo desde esa fecha

# The Odds API: región del consenso (eu incluye Pinnacle y Betfair) y cada cuánto refrescar una liga
ODDS_REGIONS=eu
ODDS_MIN_REFRESH_H=8
ODDS_API_FOOTBALL=0     # 1 = gastar créditos también en ligas nacionales (ya tienen bet365 gratis)

# OddsPapi: bet365 + Pinnacle en la misma consulta, solo partidos de las próximas 47 h
ODDSPAPI_BOOKS=bet365,pinnacle
ODDSPAPI_WINDOW_H=47
ODDSPAPI_FIXTURES_TTL_H=12
