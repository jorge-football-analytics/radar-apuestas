# Copia este fichero como .env y rellena tus claves (el .env nunca se sube a GitHub)

# https://the-odds-api.com  → plan Starter gratis (500 créditos/mes)
ODDS_API_KEY=
# https://oddspapi.io → plan gratis (250 consultas/mes). Da las cuotas de bet365 de tenis, NBA, NFL y copas europeas
ODDSPAPI_KEY=
# https://dashboard.api-football.com  → opcional; el plan gratis no incluye la temporada actual
APIFOOTBALL_KEY=

# Bot de Telegram: créalo con @BotFather y luego ejecuta `python -m radar telegram-test` para ver tu chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Banca y riesgo
BANKROLL=100            # dinero que dedicas a esto (no el que necesitas)
KELLY_FRACTION=0.25     # fracción de Kelly: 0.25 = prudente
MAX_STAKE_PCT=0.03      # nunca más del 3 % de la banca en una apuesta

# Deportes activos
SPORTS=football,tennis,basketball,nfl

# Filtros (siempre con cuotas de bet365)
MIN_EV=0.03             # valor esperado mínimo para que salga como 'Con valor' en la web (+3 %)
ALERT_EV=0.05           # valor mínimo para Telegram (+5 %), además de confianza alta
ALERT_MAX_DAY=5         # máximo de avisos élite al día
MIN_PROB=0.25           # no marcar selecciones con menos de un 25 % de probabilidad
MAX_ODDS=6.0

# The Odds API: región del consenso (eu incluye Pinnacle y Betfair) y cada cuánto refrescar una liga
ODDS_REGIONS=eu
ODDS_MIN_REFRESH_H=8
ODDS_API_FOOTBALL=0     # 1 = gastar créditos también en ligas nacionales (ya tienen bet365 gratis)
